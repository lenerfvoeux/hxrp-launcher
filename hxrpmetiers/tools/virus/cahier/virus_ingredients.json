  },
  {
   "nom": "Huile de lin",
   "fabrication": "Graines de lin → Yagen → Jarres (décantation 2 h)"
  },
  {
   "nom": "Base d'onguent",
   "fabrication": "Saindoux + cire d'abeille → Chaudron (fondre) → Table"
  },
  {
   "nom": "Bandes de laine",
   "fabrication": "Laine → Hachoir → Chaudron (ébullition)"
  },
  {
   "nom": "Charbon de bambou",
   "fabrication": "Bambou → Hachoir → Chaudron (à sec) → Yagen"
  },
  {
   "nom": "Charbon d'os",
   "fabrication": "Os → Chaudron (à sec, calcination) → Yagen"
  }
 ],
